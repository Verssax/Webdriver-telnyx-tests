{
  "name": "telnyx-wdio-tests",
  "version": "1.0.0",
  "type": "module",
  "description": "WebdriverIO E2E test suite for telnyx.com with cross-browser configs, Allure reporting, Docker, and a GitHub Actions pipeline that publishes results to GitHub Pages.",
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@wdio/allure-reporter": "^9.30.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "allure-commandline": "^2.34.0",
    "cross-env": "^7.0.3",
    "deepmerge": "^4.3.1",
    "dotenv": "^16.4.5",
    "npm-run-all2": "^6.2.6"
  },
  "scripts": {
    "test": "run-s --continue-on-error test:chrome test:firefox",
    "test:all": "npm run test",
    "test:file": "cross-env HEADLESS=false wdio run ./config/wdio.chrome.conf.js --spec",
    "test:chrome": "cross-env HEADLESS=false wdio run ./config/wdio.chrome.conf.js",
    "test:firefox": "cross-env HEADLESS=false wdio run ./config/wdio.firefox.conf.js",
    "test:ci": "cross-env HEADLESS=true wdio run ./config/wdio.chrome.conf.js",
    "wdio": "wdio run wdio.conf.js",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "docker:build:chrome": "docker build --build-arg BROWSER_IMAGE=selenium/standalone-chrome:130.0 --build-arg WDIO_CONF=config/wdio.chrome.conf.js -t telnyx-tests-chrome .",
    "docker:build:firefox": "docker build --build-arg BROWSER_IMAGE=selenium/standalone-firefox:130.0 --build-arg WDIO_CONF=config/wdio.firefox.conf.js -t telnyx-tests-firefox .",
    "docker:chrome": "docker compose run --rm chrome-tests",
    "docker:firefox": "docker compose run --rm firefox-tests",
    "docker:all": "docker compose up --build --abort-on-container-exit"
  }
}
